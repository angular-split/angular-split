{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "node"],
    "lib": ["es2022", "dom"],
    "module": "es2020",
    "moduleResolution": "node10",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "sourceMap": false
  },
  "include": ["./**/*.ts", "../cypress.config.ts"],
  "exclude": []
}
